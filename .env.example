# Askara Configuration File
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Choose your LLM provider: 'ollama' (local, free), 'openai', 'claude', 'gemini', or 'groq'
LLM_PROVIDER=ollama

# Provider Mode: 'single' (use one provider), 'auto' (auto-select best), 'failover' (fallback on failure)
LLM_PROVIDER_MODE=single

# Analytics & Metrics (for auto-selection and monitoring)
LLM_METRICS_ENABLED=true
LLM_METRICS_PATH=./data/llm_metrics.json

# ==============================================================================
# OpenAI Configuration (Only required if LLM_PROVIDER=openai)
# ==============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Models (optional, defaults shown)
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ==============================================================================
# Ollama Configuration (Only required if LLM_PROVIDER=ollama)
# ==============================================================================
# Host where Ollama is running
# For Docker on Windows: http://host.docker.internal:11434
# For Docker on Linux: http://172.17.0.1:11434 or http://localhost:11434
# For Docker on Mac: http://host.docker.internal:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Ollama Models
OLLAMA_MODEL=llama2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ==============================================================================
# Anthropic Claude Configuration (Only required if LLM_PROVIDER=claude)
# ==============================================================================
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Claude Models
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_EMBED_MODEL=voyage-large-2-instruct

# ==============================================================================
# Google Gemini Configuration (Only required if LLM_PROVIDER=gemini)
# ==============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Models
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ==============================================================================
# Groq Configuration (Only required if LLM_PROVIDER=groq)
# ==============================================================================
# Get your API key from: https://console.groq.com/
# Note: Groq doesn't provide embeddings - use Ollama or OpenAI for embeddings
GROQ_API_KEY=your_groq_api_key_here

# Groq Models (ultra-fast inference)
GROQ_MODEL=mixtral-8x7b-32768

# ==============================================================================
# Vector Database Configuration
# ==============================================================================
# Choose ONE vector database: Qdrant OR Pinecone

# Option 1: Qdrant (Default - runs in Docker container)
QDRANT_API_ENDPOINT=http://qdrant:6333

# Option 2: Pinecone (Alternative to Qdrant)
# Uncomment if using Pinecone instead of Qdrant
# Get your API key from: https://www.pinecone.io/
# PINECONE_API_ENDPOINT=https://your-index-name.svc.your-region.pinecone.io
# PINECONE_API_KEY=your_pinecone_api_key_here

# Qdrant Storage Path (Windows users: use forward slashes)
# QDRANT_STORAGE_PATH=./qdrant-data
QDRANT_LOG_LEVEL=INFO

# ==============================================================================
# ML Worker Configuration (Optional - Advanced Document Processing)
# ==============================================================================
# Enable ML Worker for enhanced document processing capabilities
# Set to 'true' to enable, 'false' to use built-in processing
ML_WORKER_ENABLED=false

# ML Worker API endpoint
# Default: http://192.168.0.250:6161/askara
ML_WORKER_ENDPOINT=http://192.168.0.250:6161/askara

# Features to enable (comma-separated):
# - ocr: Enhanced OCR for scanned documents
# - enhance: Image enhancement before OCR
# - caption: Generate captions for images/diagrams
# - classify: Auto-classify document types
# - parse: Advanced document parsing with Docling (preserves structure, extracts tables)
ML_WORKER_FEATURES=ocr,enhance,caption,parse

# ML Worker timeout in seconds
ML_WORKER_TIMEOUT=30

# ==============================================================================
# Query Rewriting (Optional - Improves Retrieval)
# ==============================================================================
# Enable query rewriting to improve document retrieval
# Uses local Ollama LLM to generate alternative phrasings of user questions
# This can significantly improve retrieval for poorly worded questions
# Set to 'true' to enable, 'false' to use queries as-is
# Note: Slightly increases latency due to LLM call before retrieval
QUERY_REWRITE_ENABLED=false

# ==============================================================================
# Application Configuration
# ==============================================================================
# Port for the web server
PORT=8100

# Enable debug mode (true/false)
DEBUG_SITE=false

# ==============================================================================
# Windows-Specific Paths (Optional)
# ==============================================================================
# Only needed when using docker-compose.windows.yml
# Use forward slashes (/) not backslashes (\)

# Path to store application data
# Example: C:/Users/YourName/Askara/data
# ASKARA_DATA_PATH=./data

# Path to store uploaded documents
# Example: C:/Users/YourName/Askara/data/documents
# ASKARA_DOCUMENTS_PATH=./data/documents

# ==============================================================================
# File Upload Configuration (Code-level constants)
# ==============================================================================
# These are hardcoded in the application and can't be changed via environment
# To modify these, edit vault-web-server/postapi/fileupload.go:
# - MAX_FILE_SIZE (default: 25 MB)
# - MAX_TOTAL_UPLOAD_SIZE (default: 50 MB)

# ==============================================================================
# Notes
# ==============================================================================
# 1. Required environment variables:
#    - LLM_PROVIDER (choose 'openai' or 'ollama')
#    - If using OpenAI: OPENAI_API_KEY is required
#    - If using Ollama: OLLAMA_HOST is required
#    - Either QDRANT_API_ENDPOINT or PINECONE_API_ENDPOINT (choose one)
#    - If using Pinecone: PINECONE_API_KEY is also required
#
# 2. Qdrant setup:
#    - When using docker-compose.yml, Qdrant runs automatically
#    - Vector dimension: 1536 (OpenAI) or 768 (Ollama nomic-embed-text)
#    - No API key required for local Qdrant instance
#    - Qdrant auto-creates collections with correct dimensions
#
# 3. Pinecone setup:
#    - Create an index with dimension 1536 (OpenAI) or 768 (Ollama)
#    - Get your endpoint from the Pinecone console
#    - Set both PINECONE_API_ENDPOINT and PINECONE_API_KEY
#
# 4. Ollama setup (FREE local AI):
#    - Install Ollama from https://ollama.ai/download
#    - Start Ollama: ollama serve
#    - Pull models: ollama pull llama2 && ollama pull nomic-embed-text
#    - For Docker: Set OLLAMA_HOST=http://host.docker.internal:11434
#    - For local dev: Set OLLAMA_HOST=http://localhost:11434
#    - GPU acceleration automatic if NVIDIA GPU detected
#
# 5. Windows users:
#    - Use docker-compose.windows.yml for Windows-specific settings
#    - Use forward slashes in paths: C:/Users/Name/path
#    - Enable WSL 2 backend in Docker Desktop for best performance
#    - To use Ollama on Windows host with RTX 3090:
#      * Install Ollama on Windows
#      * Start: ollama serve
#      * Pull models: ollama pull llama2 && ollama pull nomic-embed-text
#      * Set OLLAMA_HOST=http://host.docker.internal:11434
#      * Set LLM_PROVIDER=ollama
#
# 6. For development:
#    - Copy this file to .env
#    - Choose your LLM provider (ollama for free, openai for paid)
#    - Fill in your configuration
#    - Never commit .env to git (it's in .gitignore)
#
# 7. Switching providers:
#    - Change LLM_PROVIDER in .env
#    - Restart the application
#    - NOTE: Clear vector database when switching between providers
#      (embeddings from different models are incompatible)
#
# 8. New Provider Modes (Advanced):
#    - single: Use one LLM provider (traditional mode)
#    - auto: Automatically select best provider based on performance metrics
#    - failover: Try providers in order until one succeeds
#    To use auto/failover: Configure multiple provider API keys
#
# 9. Provider Options:
#    - ollama: FREE, local, GPU-accelerated, privacy-focused
#    - openai: Paid, cloud, high quality, GPT-4/3.5
#    - claude: Paid, cloud, excellent reasoning (Anthropic)
#    - gemini: Paid, cloud, fast and affordable (Google)
#    - groq: Paid, cloud, ULTRA FAST inference (no embeddings)
#
# 10. Analytics & Metrics:
#     - Tracks latency, success rate, costs for each provider
#     - Used for auto-selection in 'auto' mode
#     - View metrics at /api/providers/stats
#     - Health monitoring at /api/providers/health
